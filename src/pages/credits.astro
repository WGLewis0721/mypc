---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Site Credits | MYPC" active="credits">
  <section class="section section--white">
    <div class="wrap wrap--narrow reveal legal">
      <p class="eyebrow">Colophon</p>
      <h1 class="t-display-l">Site Credits</h1>
      <span class="rule"></span>

      <p>
        A concept demonstration built by Gray Matter Web Studio. Design system and layout
        applied from the MYPC brandkit.
      </p>

      <h2>Typography</h2>
      <p>
        Playfair Display, Montserrat, and Great Vibes, all under the SIL Open Font License.
      </p>

      <h2>Imagery</h2>
      <p>
        Hero photograph: &ldquo;West Front of the Alabama State Capitol, Montgomery, AL&rdquo;
        via Openverse, licensed CC&nbsp;BY&nbsp;2.0 — cropped and colour-graded. Portraits and
        group photography were generated for this concept demonstration.
      </p>

      <a class="btn btn--secondary-light legal__back" href="/">Back to home</a>
    </div>
  </section>
</Layout>

<style>
  .legal p {
    margin-top: 1rem;
    max-width: 62ch;
    color: var(--color-ink-500);
    line-height: 1.7;
  }
  .legal h2 {
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-900);
  }
  .legal__back {
    margin-top: 2.5rem;
    text-decoration: none;
  }
</style>
