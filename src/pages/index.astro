---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FocusCard from "../components/FocusCard.astro";
import LeadershipCard from "../components/LeadershipCard.astro";
import EventCard from "../components/EventCard.astro";
import MembershipSteps from "../components/MembershipSteps.astro";
import SocialCommunity from "../components/SocialCommunity.astro";
import CTA from "../components/CTA.astro";
import Icon from "../components/Icon.astro";
import { FOCUS, LEADERSHIP, MEMBERSHIP } from "../data/home";
import { fetchEvents } from "../wix/events/events";
import { fetchPosts } from "../wix/blog/posts";
import type { EventSummary } from "../wix/events/types";
import type { PostSummary } from "../wix/blog/types";

let events: EventSummary[] = [];
let posts: PostSummary[] = [];
try {
  events = await fetchEvents();
} catch {
  // Homepage still renders without the events strip.
}
try {
  posts = (await fetchPosts()).posts;
} catch {
  // Homepage still renders without the news strip.
}

/** "Nov 12, 2026, 5:30 PM" -> { month:"NOV", day:"12", time:"5:30 PM" } */
function dateParts(e: EventSummary) {
  const bits = (e.dateLabel || "").split(", ");
  const head = (bits[0] || "").split(" ");
  const iso = e.startDateIso ? new Date(e.startDateIso) : null;
  return {
    month: (head[0] || (iso ? iso.toLocaleString("en-US", { month: "short" }) : "")).toUpperCase().slice(0, 3),
    day: head[1] || (iso ? String(iso.getDate()) : ""),
    time: bits.length > 2 ? bits.slice(2).join(", ") : "",
  };
}

const featured = events[0];
const restEvents = events.slice(1, 3);
const latestPosts = posts.slice(0, 3);
---

<Layout active="home">
  <Hero img="/img/hero-capitol.webp" />

  <!-- Mission statement -->
  <section id="about" class="section section--paper mission">
    <div class="wrap wrap--narrow reveal">
      <p class="mission__body">
        The Mayor&rsquo;s Young Professional Council brings together young
        professionals who <strong>connect, collaborate, and serve</strong> so the next
        generation has a real hand in Montgomery&rsquo;s future.
      </p>
      <a class="link-arrow" href="/join">
        Become a member
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <hr class="seam" aria-hidden="true" />

  <!-- 1 · Focus areas (rule-divided ledger) -->
  <section id="focus" class="section section--white">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader title={FOCUS.title} lede={FOCUS.lede} />
      </div>
      <div class="focus-ledger reveal">
        {FOCUS.items.map((item) => <FocusCard {...item} href="/about" />)}
      </div>
    </div>
  </section>

  <!-- 2 · Featured leadership (featured + row) -->
  <section id="leadership" class="section section--navy">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader
          onNavy
          eyebrow={LEADERSHIP.eyebrow}
          title={LEADERSHIP.title}
          link={{ label: "Meet the full Council", href: "/council" }}
        />
      </div>
      <div class="leaders reveal">
        <LeadershipCard featured {...LEADERSHIP.featured} />
        <div class="leaders__row">
          {LEADERSHIP.members.map((m) => <LeadershipCard {...m} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Upcoming events (live from Wix Events) -->
  <section id="events" class="section section--paper">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader
          title="Upcoming events"
          link={{ label: "View all events", href: "/events" }}
        />
      </div>
      {
        events.length === 0 ? (
          <p class="reveal" style="color:var(--color-ink-500)">
            No events on the calendar right now — <a href="/events" style="color:var(--color-gold-600);text-decoration:underline">check the calendar</a>.
          </p>
        ) : (
          <div class="events reveal">
            <EventCard
              featured
              {...dateParts(featured)}
              kicker="Featured event"
              title={featured.title}
              venue={featured.locationType === "ONLINE" ? "Online event" : featured.locationName}
              blurb={featured.shortDescription}
              img={featured.imageUrl}
              href={`/events/${featured.slug}`}
            />
            <div class="events__list">
              {restEvents.map((e) => (
                <EventCard
                  {...dateParts(e)}
                  title={e.title}
                  venue={e.locationType === "ONLINE" ? "Online event" : e.locationName}
                  href={`/events/${e.slug}`}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <hr class="seam" aria-hidden="true" />

  <!-- 4 · Membership funnel -->
  <section id="join" class="section section--navy">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader onNavy title={MEMBERSHIP.title} lede={MEMBERSHIP.lede} />
      </div>
      <figure class="join-photo reveal">
        <img
          src="/img/members-group.webp"
          alt="Members of the Mayor’s Young Professional Council"
          width="1256"
          height="835"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="reveal">
        <MembershipSteps steps={MEMBERSHIP.steps} />
      </div>
      <div class="join-cta reveal">
        <CTA
          tone="gold"
          title="Ready to make an impact?"
          body="Applications are open to young professionals who live or work in Montgomery and are ready to lead, serve, and grow."
          action={MEMBERSHIP.cta}
        />
      </div>
    </div>
  </section>

  <!-- 5 · Latest news (live from Wix Blog) -->
  {
    latestPosts.length > 0 && (
      <section id="news" class="section section--white">
        <div class="wrap wrap--wide">
          <div class="reveal">
            <SectionHeader
              title="From the Council"
              link={{ label: "All news", href: "/blog" }}
            />
          </div>
          <div class="news-grid reveal">
            {latestPosts.map((p) => (
              <a class="news-card card" href={`/blog/${p.slug}`}>
                {p.coverUrl && (
                  <div class="news-card__media">
                    <img src={p.coverUrl} alt={p.title} width="480" height="270" loading="lazy" />
                  </div>
                )}
                <div class="news-card__body">
                  <h3 class="t-h3">{p.title}</h3>
                  {p.excerpt && <p class="news-card__excerpt">{p.excerpt}</p>}
                  <p class="t-meta news-card__meta">{p.dateLabel}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 6 · Community -->
  <section id="community" class="section section--paper">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SocialCommunity />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Mission band */
  .mission__body {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 1.6vw, 2.125rem);
    line-height: 1.32;
    font-weight: 480;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .mission__body strong {
    font-weight: 600;
    font-style: italic;
  }

  /* Focus ledger: rule-divided columns, no cards */
  .focus-ledger {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .focus-ledger > :global(*) {
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }
  @media (min-width: 700px) {
    .focus-ledger {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
    }
    .focus-ledger > :global(*) {
      padding-inline: 0;
    }
    .focus-ledger > :global(*:nth-child(2)) {
      border-top: 1px solid var(--color-border-light);
    }
  }
  @media (min-width: 1024px) {
    .focus-ledger {
      grid-template-columns: repeat(4, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .focus-ledger > :global(*) {
      border-top: 2px solid var(--color-navy-900);
      padding-top: 1.5rem;
      border-bottom: 0;
    }
  }

  /* Leadership: featured card + supporting row */
  .leaders {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
  }
  .leaders__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  @media (min-width: 1024px) {
    .leaders {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
      align-items: center;
    }
    .leaders__row {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
  }

  /* Events: featured + compact rule-separated list */
  .events {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 2.75rem);
  }
  .events__list {
    display: flex;
    flex-direction: column;
  }
  .events__list > :global(*) {
    border-top: 1px solid var(--color-border-light);
  }
  .events__list > :global(*:first-child) {
    border-top: 0;
  }
  @media (min-width: 1024px) {
    .events {
      grid-template-columns: 1.25fr 1fr;
      align-items: start;
    }
  }

  .join-photo {
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
    border: 1px solid var(--border-on-navy);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-navy-900);
  }
  .join-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1256 / 835;
    object-fit: cover;
  }
  .join-photo figcaption {
    padding: 0.65rem 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-cloud);
    border-top: 1px solid var(--border-on-navy);
  }
  .join-photo figcaption span {
    color: rgb(255 255 255 / 0.4);
  }

  .join-cta {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  /* News grid */
  .news-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .news-card {
    display: block;
    overflow: hidden;
  }
  .news-card__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border-light);
  }
  .news-card__body {
    padding: 1.25rem;
  }
  .news-card__body .t-h3 {
    color: var(--color-ink-900);
  }
  .news-card__excerpt {
    margin-top: 0.4rem;
    color: var(--color-ink-500);
    font-size: 0.9rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card__meta {
    margin-top: 0.75rem;
    color: var(--color-ink-500);
  }
</style>
