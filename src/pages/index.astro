---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FocusCard from "../components/FocusCard.astro";
import LeadershipCard from "../components/LeadershipCard.astro";
import EventCard from "../components/EventCard.astro";
import MembershipSteps from "../components/MembershipSteps.astro";
import SocialCommunity from "../components/SocialCommunity.astro";
import CivicField from "../components/CivicField.astro";
import CTA from "../components/CTA.astro";
import Icon from "../components/Icon.astro";
import { FOCUS, LEADERSHIP, MEMBERSHIP } from "../data/home";
import { fetchEvents } from "../wix/events/events";
import { fetchPosts } from "../wix/blog/posts";
import type { EventSummary } from "../wix/events/types";
import type { PostSummary } from "../wix/blog/types";

let events: EventSummary[] = [];
let posts: PostSummary[] = [];
try {
  events = await fetchEvents();
} catch {
  // Homepage still renders without the events strip.
}
try {
  posts = (await fetchPosts()).posts;
} catch {
  // Homepage still renders without the news strip.
}

/** "Nov 12, 2026, 5:30 PM" -> { month:"NOV", day:"12", time:"5:30 PM" } */
function dateParts(e: EventSummary) {
  const bits = (e.dateLabel || "").split(", ");
  const head = (bits[0] || "").split(" ");
  const iso = e.startDateIso ? new Date(e.startDateIso) : null;
  return {
    month: (head[0] || (iso ? iso.toLocaleString("en-US", { month: "short" }) : "")).toUpperCase().slice(0, 3),
    day: head[1] || (iso ? String(iso.getDate()) : ""),
    time: bits.length > 2 ? bits.slice(2).join(", ") : "",
  };
}

const featured = events[0];
const restEvents = events.slice(1, 3);
const latestPosts = posts.slice(0, 3);
---

<Layout active="home">
  <Hero img="/img/hero-capitol.webp" />

  <!-- Mission statement -->
  <section id="about" class="section section--paper mission">
    <div class="wrap mission__inner reveal">
      <span class="mission__bar" aria-hidden="true"></span>
      <div class="mission__col">
        <p class="mission__body">
          The Mayor&rsquo;s Young Professional Council brings together young
          professionals who <strong>connect, collaborate, and serve</strong> so the next
          generation has a real hand in Montgomery&rsquo;s future.
        </p>
        <a class="link-arrow" href="/join">
          Become a member
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <hr class="seam" aria-hidden="true" />

  <!-- 1 · Focus areas — split: sticky intro / charter ledger -->
  <section id="focus" class="section section--white focus">
    <div class="wrap wrap--wide focus__grid">
      <div class="focus__intro reveal">
        <h2 class="t-h2">{FOCUS.title}</h2>
        <span class="rule rule--lg"></span>
        <p class="focus__lede">{FOCUS.lede}</p>
      </div>
      <div class="focus__ledger reveal">
        {FOCUS.items.map((item, i) => <FocusCard n={i + 1} {...item} href="/about" />)}
      </div>
    </div>
  </section>

  <!-- 2 · Featured leadership (featured + row) -->
  <section id="leadership" class="section section--navy">
    <CivicField pos="top-right" />
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader
          onNavy
          eyebrow={LEADERSHIP.eyebrow}
          title={LEADERSHIP.title}
          link={{ label: "Meet the full Council", href: "/council" }}
        />
      </div>
      <div class="leaders reveal">
        <LeadershipCard featured {...LEADERSHIP.featured} />
        <div class="leaders__row">
          {LEADERSHIP.members.map((m) => <LeadershipCard {...m} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Upcoming events (live from Wix Events) -->
  <section id="events" class="section section--paper">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader
          title="Upcoming events"
          link={{ label: "View all events", href: "/events" }}
        />
      </div>
      {
        events.length === 0 ? (
          <p class="reveal" style="color:var(--color-ink-500)">
            No events on the calendar right now — <a href="/events" style="color:var(--color-gold-600);text-decoration:underline">check the calendar</a>.
          </p>
        ) : (
          <div class="events reveal">
            <EventCard
              featured
              {...dateParts(featured)}
              kicker="Featured event"
              title={featured.title}
              venue={featured.locationType === "ONLINE" ? "Online event" : featured.locationName}
              blurb={featured.shortDescription}
              img={featured.imageUrl}
              href={`/events/${featured.slug}`}
            />
            <div class="events__list">
              {restEvents.map((e) => (
                <EventCard
                  {...dateParts(e)}
                  title={e.title}
                  venue={e.locationType === "ONLINE" ? "Online event" : e.locationName}
                  href={`/events/${e.slug}`}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <hr class="seam" aria-hidden="true" />

  <!-- 4 · Membership funnel -->
  <section id="join" class="section section--navy">
    <CivicField pos="bottom-left" />
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SectionHeader onNavy title={MEMBERSHIP.title} lede={MEMBERSHIP.lede} />
      </div>
      <figure class="join-photo reveal">
        <img
          src="/img/members-group.webp"
          alt="Members of the Mayor’s Young Professional Council"
          width="1256"
          height="835"
          loading="lazy"
          decoding="async"
          onerror="this.closest('.join-photo').classList.add('join-photo--empty')"
        />
        <span class="join-photo__edge" aria-hidden="true"></span>
        <span class="join-photo__wash" aria-hidden="true"></span>
      </figure>
      <div class="reveal">
        <MembershipSteps steps={MEMBERSHIP.steps} />
      </div>
      <div class="join-cta reveal">
        <CTA
          tone="gold"
          title="Ready to make an impact?"
          body="Applications are open to young professionals who live or work in Montgomery and are ready to lead, serve, and grow."
          action={MEMBERSHIP.cta}
        />
      </div>
    </div>
  </section>

  <!-- 5 · Latest news (live from Wix Blog) -->
  {
    latestPosts.length > 0 && (
      <section id="news" class="section section--white">
        <div class="wrap wrap--wide">
          <div class="reveal">
            <SectionHeader
              title="From the Council"
              link={{ label: "All news", href: "/blog" }}
            />
          </div>
          <div class="news reveal">
            {latestPosts[0] && (
              <a class="news-lead" href={`/blog/${latestPosts[0].slug}`}>
                <div class="news-lead__media">
                  <span class="news-lead__tag">Council News</span>
                  <svg class="news-lead__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.4l2.7 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.1 6.1 20.3l1.2-6.4L2.6 9.1l6.4-.8z" />
                  </svg>
                  {latestPosts[0].coverUrl && (
                    <img
                      src={latestPosts[0].coverUrl}
                      alt={latestPosts[0].title}
                      width="720"
                      height="480"
                      loading="lazy"
                      onerror="this.remove()"
                    />
                  )}
                </div>
                <div class="news-lead__text">
                  <h3 class="news-lead__title">{latestPosts[0].title}</h3>
                  {latestPosts[0].excerpt && (
                    <p class="news-lead__excerpt">{latestPosts[0].excerpt}</p>
                  )}
                  <p class="t-meta news__meta">{latestPosts[0].dateLabel}</p>
                </div>
              </a>
            )}
            {latestPosts.length > 1 && (
              <div class="news__rest">
                {latestPosts.slice(1).map((p) => (
                  <a class="news-row" href={`/blog/${p.slug}`}>
                    <span>
                      <span class="news-row__title">{p.title}</span>
                      <span class="t-meta news__meta">{p.dateLabel}</span>
                    </span>
                    <Icon name="arrow-right" size={18} />
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- 6 · Community -->
  <section id="community" class="section section--paper">
    <div class="wrap wrap--wide">
      <div class="reveal">
        <SocialCommunity />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Mission band — editorial pull-quote, left-aligned with a civic gold bar */
  .mission__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    max-width: 64rem;
  }
  .mission__bar {
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      var(--color-gold-500) 0 62%,
      var(--color-red-600) 62% 100%
    );
  }
  .mission__body {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.05rem + 2vw, 2.5rem);
    line-height: 1.28;
    font-weight: 480;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .mission__body strong {
    font-weight: 600;
    font-style: italic;
  }

  /* Focus: split — sticky intro column + charter ledger */
  .focus__grid {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }
  .focus__intro .rule {
    margin: 1.1rem 0 1.25rem;
  }
  .focus__lede {
    max-width: 40ch;
    color: var(--color-ink-500);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .focus__ledger > :global(*) {
    border-top: 2px solid var(--color-navy-900);
  }
  .focus__ledger > :global(* + *) {
    border-top: 1px solid var(--color-border-light);
  }
  @media (min-width: 1000px) {
    .focus__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }
    .focus__intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* Leadership: featured card + supporting row */
  .leaders {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
  }
  .leaders__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  @media (min-width: 1024px) {
    .leaders {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
      align-items: center;
    }
    .leaders__row {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
  }

  /* Events: featured + compact rule-separated list */
  .events {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 2.75rem);
  }
  .events__list {
    display: flex;
    flex-direction: column;
  }
  .events__list > :global(*) {
    border-top: 1px solid var(--color-border-light);
  }
  .events__list > :global(*:first-child) {
    border-top: 0;
  }
  @media (min-width: 1024px) {
    .events {
      grid-template-columns: 1.25fr 1fr;
      align-items: start;
    }
  }

  .join-photo {
    position: relative;
    margin: 0 0 clamp(2.5rem, 1.8rem + 3vw, 4rem);
    border: 1px solid var(--border-on-navy);
    border-radius: var(--radius-md);
    overflow: hidden;
    background:
      radial-gradient(130% 120% at 85% 10%, var(--color-navy-800), var(--color-navy-900) 70%);
    aspect-ratio: 1256 / 620;
  }
  .join-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* gold + red diagonal seam on the top-left edge, echoing the hero frame */
  .join-photo__edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      126deg,
      var(--color-gold-500) 0 1.6%,
      var(--color-red-600) 1.6% 3%,
      transparent 3% 100%
    );
    pointer-events: none;
  }
  .join-photo__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgb(6 16 29 / 0.55), rgb(6 16 29 / 0) 52%);
    pointer-events: none;
  }
  .join-photo--empty {
    aspect-ratio: 1256 / 420;
  }
  .join-photo--empty .join-photo__wash {
    display: none;
  }

  .join-cta {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  /* News — editorial: one lead, then rule-divided rows */
  .news {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
  }
  .news__meta {
    color: var(--color-ink-500);
  }
  .news-lead {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .news-lead__media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-md);
    overflow: hidden;
    background:
      radial-gradient(130% 120% at 82% 10%, var(--color-navy-800), var(--color-navy-900) 72%);
  }
  .news-lead__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-lead__mark {
    position: absolute;
    right: -6%;
    bottom: -14%;
    width: 46%;
    color: var(--color-gold-500);
    opacity: 0.1;
  }
  .news-lead__tag {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 1;
    padding: 0.3rem 0.65rem;
    background: var(--color-navy-900);
    color: var(--color-gold-500);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .news-lead__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.25rem);
    line-height: 1.12;
    font-weight: 500;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .news-lead__excerpt {
    margin-top: 0.6rem;
    max-width: 52ch;
    color: var(--color-ink-500);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .news-lead .news__meta {
    margin-top: 0.9rem;
  }
  .news__rest {
    display: flex;
    flex-direction: column;
  }
  .news-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border-light);
    color: var(--color-ink-900);
    transition: color var(--dur) var(--ease);
  }
  .news-row:last-child {
    border-bottom: 1px solid var(--color-border-light);
  }
  .news-row__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.25;
    font-weight: 500;
  }
  .news-row .news__meta {
    display: block;
    margin-top: 0.3rem;
  }
  .news-row :global(svg) {
    flex: none;
    color: var(--color-gold-600);
    transition: transform var(--dur) var(--ease);
  }
  .news-row:hover {
    color: var(--color-gold-700, var(--color-gold-600));
  }
  .news-row:hover :global(svg) {
    transform: translateX(4px);
  }
  @media (min-width: 860px) {
    .news-lead {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
</style>
