---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Support the Council | MYPC" active="donate">
  <section class="section section--navy stub">
    <div class="wrap wrap--narrow reveal">
      <p class="stub__eyebrow">Support the Council</p>
      <h1 class="t-display-l">Giving</h1>
      <span class="rule"></span>
      <p class="stub__body">
        Online giving isn&rsquo;t open yet. In the meantime, the most valuable thing
        you can give the Council is your time — apply to join, or come to an event.
      </p>
      <div class="stub__actions">
        <a class="btn btn--primary" href="/join">
          Apply to Join
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn--secondary-navy" href="/events">Upcoming events</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stub {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .stub__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    margin-bottom: 0.75rem;
  }
  .stub .rule {
    margin: 1.25rem 0;
  }
  .stub__body {
    max-width: 48ch;
    color: var(--color-cloud);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }
  .stub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
