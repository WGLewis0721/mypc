---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Donate | MYPC" active="donate">
  <section class="section section--navy stub">
    <div class="wrap wrap--narrow reveal">
      <p class="stub__eyebrow">Support the Council</p>
      <h1 class="t-display-l">Donations</h1>
      <span class="rule"></span>
      <p class="stub__body">
        This page is a placeholder in the concept build. A payment provider and the
        Council&rsquo;s giving options are <strong>TODO: client to supply</strong>.
      </p>
      <a class="btn btn--primary" href="/#join">
        Explore membership instead
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>
</Layout>

<style>
  .stub {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .stub__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    margin-bottom: 0.75rem;
  }
  .stub .rule {
    margin: 1.25rem 0;
  }
  .stub__body {
    max-width: 48ch;
    color: var(--color-cloud);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }
  .stub__body strong {
    color: #fff;
    font-weight: 600;
  }
</style>
