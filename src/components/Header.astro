---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import MobileNav from "./MobileNav.astro";
import MemberMenu from "./members/MemberMenu";
import { NAV } from "../data/home";

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="hdr" data-hdr>
  <div class="wrap wrap--wide hdr__inner">
    <Logo sub class="hdr__logo" />

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["hdr__link", { "is-active": active === item.key }]}
                aria-current={active === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <span class="hdr__member">
        <MemberMenu client:only="react" />
      </span>
      <a href="/join" class="btn btn--primary hdr__cta">Apply to Join</a>
      <button
        type="button"
        class="hdr__burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<MobileNav active={active} />

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-navy-900) 94%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--border-on-navy);
    transition: box-shadow var(--dur) var(--ease);
  }
  .hdr[data-scrolled] {
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.7);
  }
  .hdr__inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .hdr__logo {
    margin-right: auto;
  }

  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
  }
  .hdr__link {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-cloud);
    transition: color var(--dur) var(--ease);
  }
  .hdr__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .hdr__link:hover {
    color: #fff;
  }
  .hdr__link:hover::after {
    transform: scaleX(1);
  }
  .hdr__link.is-active {
    color: #fff;
  }
  .hdr__link.is-active::after {
    transform: scaleX(1);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hdr__cta {
    min-height: 42px;
    padding: 0.6rem 1.1rem;
    white-space: nowrap;
  }

  /* MemberMenu (shipped) styles itself from the @theme tokens for a light ground —
     re-tone it for the navy header. Specificity beats the Tailwind utility classes. */
  .hdr__member :global(a),
  .hdr__member :global(button),
  .hdr__member :global(span) {
    color: #fff;
    font-family: var(--font-sans);
  }
  .hdr__member :global(a.bg-primary) {
    background: var(--color-gold-600);
    color: var(--color-navy-900);
    font-weight: 600;
  }
  .hdr__member :global(a.bg-primary:hover) {
    background: var(--color-gold-500);
  }
  .hdr__member :global(.bg-secondary) {
    background: rgb(255 255 255 / 0.14);
  }
  .hdr__member :global(.text-muted-foreground) {
    color: var(--color-cloud);
  }
  @media (max-width: 1023px) {
    .hdr__member {
      display: none;
    }
  }
  .hdr__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--border-on-navy);
    border-radius: var(--radius-sm);
    color: #fff;
  }

  @media (max-width: 1023px) {
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
    .hdr__burger {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr {
      backdrop-filter: none;
      background: var(--color-navy-900);
    }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>("[data-hdr]");
  if (hdr) {
    const onScroll = () => hdr.toggleAttribute("data-scrolled", window.scrollY > 4);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
