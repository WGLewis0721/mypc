---
import Placeholder from "./Placeholder.astro";
import { HERO } from "../data/home";

interface Props {
  img?: string;
}
const { img } = Astro.props;
const STAR =
  "M100 4 L124 68 L193 70 L138 112 L158 179 L100 139 L42 179 L62 112 L7 70 L76 68 Z";
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <svg viewBox="0 0 600 500" preserveAspectRatio="xMaxYMid slice" class="hero__burst">
      <g stroke="var(--color-gold-500)" stroke-width="1">
        {
          Array.from({ length: 22 }).map((_, i) => {
            const a = (i / 22) * Math.PI * 2;
            return (
              <line
                x1="480"
                y1="140"
                x2={480 + Math.cos(a) * 640}
                y2={140 + Math.sin(a) * 640}
              />
            );
          })
        }
      </g>
    </svg>
    <svg viewBox="0 0 200 200" class="hero__star">
      <path d={STAR} transform="translate(6 5) rotate(10 100 100)" fill="none" stroke="var(--color-navy-700)" stroke-width="2.5" />
      <path d={STAR} fill="none" stroke="var(--color-gold-500)" stroke-width="1.5" />
    </svg>
    <svg viewBox="0 0 240 160" class="hero__dome">
      <path
        d="M20 160 V96 a100 64 0 0 1 200 0 V160 M120 32 a58 58 0 0 1 58 58 M120 32 a58 58 0 0 0 -58 58 M112 30 h16 v-14 h-16 z M118 4 h4 v12 h-4 z"
        fill="none"
        stroke="var(--color-navy-700)"
        stroke-width="3"
      ></path>
    </svg>
  </div>

  <div class="wrap wrap--wide hero__inner">
    <div class="hero__content">
      <p class="t-script hero__script">{HERO.script}</p>
      <h1 class="t-display-xl hero__title">
        {HERO.title.map((line) => <span>{line}</span>)}
      </h1>
      <p class="hero__tagline">
        <span class="hero__tagrule" aria-hidden="true"></span>
        {HERO.tagline.map((word) => <span>{word}</span>)}
      </p>
      <p class="t-body-lg hero__lede">{HERO.lede}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={HERO.primary.href}>{HERO.primary.label}</a>
        <a class="btn btn--secondary-navy" href={HERO.secondary.href}>
          {HERO.secondary.label}
        </a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__frame">
        {
          img ? (
            <img
              src={img}
              alt="The Alabama State Capitol in Montgomery at golden hour"
              width="1280"
              height="1024"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          ) : (
            <Placeholder ratio="5 / 4" tone="navy-800" />
          )
        }
        <span class="hero__frame-wash" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--color-navy-900);
    color: #fff;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__burst {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.04;
  }
  @media (max-width: 700px) {
    .hero__burst {
      opacity: 0.025;
    }
  }
  .hero__star {
    position: absolute;
    top: 4%;
    left: -8%;
    width: clamp(280px, 42vw, 620px);
    aspect-ratio: 1;
    opacity: 0.07;
  }
  .hero__dome {
    position: absolute;
    right: 3%;
    bottom: 0;
    width: clamp(180px, 24vw, 300px);
    opacity: 0.42;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, 4rem);
    align-items: center;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }
  .hero__script {
    margin-top: 0;
    color: var(--color-gold-300);
  }
  .hero__title {
    margin-top: 0.35rem;
    color: #fff;
  }
  .hero__title span {
    display: block;
  }
  .hero__tagline {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.1rem;
    font-family: var(--font-sans);
    font-size: clamp(0.8125rem, 0.72rem + 0.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
  }
  .hero__tagrule {
    width: 34px;
    height: 3px;
    background: var(--color-gold-500);
    flex: none;
  }
  .hero__lede {
    margin-top: 1.35rem;
    max-width: 44ch;
    color: var(--color-cloud);
  }
  .hero__cta {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* media panel + diagonal gold/red framing */
  .hero__media {
    position: relative;
    --cut: 16%;
  }
  .hero__media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      118deg,
      var(--color-gold-500) 0 3%,
      var(--color-red-600) 3% 5.6%,
      transparent 5.6% 100%
    );
  }
  .hero__frame {
    position: relative;
    height: 100%;
    clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero__frame :global(.ph) {
    background: linear-gradient(
      155deg,
      var(--color-navy-700),
      var(--color-navy-800) 70%
    );
    border-color: rgb(255 255 255 / 0.16);
  }
  .hero__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }
  /* navy wash on the photo — legibility + tonal cohesion with the section */
  .hero__frame-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 16 29 / 0.62) 0%, rgb(6 16 29 / 0) 44%),
      linear-gradient(0deg, rgb(6 16 29 / 0.42), rgb(6 16 29 / 0) 58%);
  }

  @media (min-width: 1024px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(560px, 82vh, 780px);
    }
    .hero__inner {
      width: 100%;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    }
    .hero__media {
      align-self: stretch;
      min-height: 30rem;
      /* bleed the panel to the right edge of the viewport */
      margin-right: min(0px, calc((var(--container-wide) - 100vw) / 2 - var(--gutter)));
    }
    .hero__frame :global(img) {
      aspect-ratio: auto;
    }
  }

  @media (max-width: 1023px) {
    .hero__media {
      --cut: 0%;
      margin-top: 0.5rem;
    }
    .hero__media::before {
      inset: 0 0 auto 0;
      height: 8px;
      background: linear-gradient(
        90deg,
        var(--color-gold-500) 0 62%,
        var(--color-red-600) 62% 100%
      );
    }
    .hero__frame {
      clip-path: none;
      padding-top: 8px;
    }
    .hero__frame :global(img) {
      aspect-ratio: 16 / 10;
    }
    .hero__frame-wash {
      top: 8px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 1.5rem;
    }
    .hero__tagline {
      letter-spacing: 0.1em;
      gap: 0.45rem 0.85rem;
    }
  }

  @media (max-width: 460px) {
    .hero__cta .btn {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__content > *,
    .hero__title span,
    .hero__media,
    .hero__star {
      animation: hero-rise 0.66s var(--ease-out) backwards;
    }
    .hero__star {
      animation-duration: 1.1s;
      animation-delay: 0.15s;
    }
    .hero__script {
      animation-delay: 0.08s;
    }
    .hero__title span:nth-child(1) {
      animation-delay: 0.17s;
    }
    .hero__title span:nth-child(2) {
      animation-delay: 0.24s;
    }
    .hero__tagline {
      animation-delay: 0.34s;
    }
    .hero__lede {
      animation-delay: 0.42s;
    }
    .hero__cta {
      animation-delay: 0.5s;
    }
    .hero__media {
      animation-delay: 0.3s;
      animation-duration: 0.85s;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
