---
import Icon from "./Icon.astro";
/**
 * Stand-in for approved photography. Keeps aspect ratio reserved so swapping in
 * a real <img> causes no layout shift. `label` records the art-direction intent.
 */
interface Props {
  ratio?: string; // e.g. "4 / 5", "4 / 3", "16 / 9"
  label: string;
  tone?: "navy" | "navy-800";
  class?: string;
}
const { ratio = "4 / 3", label, tone = "navy-800", class: cls } = Astro.props;
const bg = tone === "navy" ? "var(--color-navy-900)" : "var(--color-navy-800)";
---
<div class={`ph ${cls ?? ""}`} style={`--ph-ratio:${ratio};--ph-bg:${bg}`}>
  <Icon name="star" size={22} />
  <span class="ph__label">{label}</span>
  <span class="ph__todo">TODO: client to supply</span>
</div>

<style>
  .ph {
    aspect-ratio: var(--ph-ratio);
    width: 100%;
    background: var(--ph-bg);
    border: 1px solid var(--border-on-navy);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    color: var(--color-gold-500);
  }
  .ph__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-cloud);
    max-width: 26ch;
    text-wrap: balance;
  }
  .ph__todo {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.35);
  }
</style>
