---
import Icon from "./Icon.astro";
import { SOCIAL } from "../data/home";
---

<div class="soc">
  <p class="soc__eyebrow">{SOCIAL.eyebrow}</p>
  <h3 class="soc__headline">{SOCIAL.headline}</h3>
  <p class="soc__body">{SOCIAL.body}</p>
  <div class="soc__actions">
    <a class="btn btn--primary" href={SOCIAL.cta.href}>{SOCIAL.cta.label}</a>
    <a class="link-arrow" href={SOCIAL.secondary.href}>
      {SOCIAL.secondary.label}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</div>

<style>
  .soc {
    max-width: 60ch;
  }
  .soc__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
  }
  .soc__headline {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem);
    line-height: 1.14;
    font-weight: 520;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .soc__body {
    margin-top: 0.9rem;
    color: var(--color-ink-500);
    font-size: 1rem;
    line-height: 1.65;
  }
  .soc__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
