---
import Icon from "./Icon.astro";
import Placeholder from "./Placeholder.astro";
import { SOCIAL } from "../data/home";
---

<div class="soc">
  <article class="soc__feature">
    <div class="soc__feature-media">
      <Placeholder ratio="16 / 9" tone="navy-800" label="Community story image" />
    </div>
    <div class="soc__feature-text">
      <p class="soc__tag">{SOCIAL.featured.tag}</p>
      <h3 class="soc__feature-title">{SOCIAL.featured.title}</h3>
      <p class="soc__feature-body">{SOCIAL.featured.body}</p>
      <a class="link-arrow" href="/#community">
        Read the story
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </article>

  <div class="soc__side">
    <ul class="soc__more">
      {
        SOCIAL.more.map((h) => (
          <li>
            <a href="/#community" class="soc__more-item">
              <span class="soc__tag">{h.tag}</span>
              <span class="soc__more-title">{h.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="soc__channels">
      <p class="soc__channels-label">Follow along</p>
      <div class="soc__channels-row">
        {
          SOCIAL.channels.map((c) => (
            <a class="soc__channel" href="#" aria-label={`${c.label} (${c.handle})`}>
              <Icon name={c.icon as "instagram" | "linkedin" | "facebook"} size={20} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .soc {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 940px) {
    .soc {
      grid-template-columns: 1.35fr 0.9fr;
      align-items: start;
    }
  }

  .soc__feature {
    display: grid;
    gap: 1.25rem;
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .soc__feature-media :global(.ph) {
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .soc__feature-text {
    padding: clamp(1.25rem, 1rem + 2vw, 2rem);
    padding-top: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .soc__feature-title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    line-height: 1.15;
    font-weight: 520;
    color: var(--color-ink-900);
  }
  .soc__feature-body {
    max-width: 48ch;
    color: var(--color-ink-500);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .soc__feature .link-arrow {
    margin-top: 0.35rem;
  }

  .soc__tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
  }

  .soc__side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .soc__more {
    display: flex;
    flex-direction: column;
  }
  .soc__more-item {
    display: block;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border-light);
  }
  .soc__more li:first-child .soc__more-item {
    border-top: 0;
    padding-top: 0;
  }
  .soc__more-title {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-ink-900);
    transition: color var(--dur) var(--ease);
  }
  .soc__more-item:hover .soc__more-title {
    color: var(--color-gold-700, var(--color-gold-600));
  }

  .soc__channels {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
  }
  .soc__channels-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin-bottom: 0.75rem;
  }
  .soc__channels-row {
    display: flex;
    gap: 0.6rem;
  }
  .soc__channel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-navy-900);
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .soc__channel:hover {
    border-color: var(--color-gold-500);
    background: rgb(10 26 56 / 0.04);
  }
</style>
