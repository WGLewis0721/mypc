---
import Icon from "./Icon.astro";
import { SOCIAL } from "../data/home";
---

<div class="soc">
  <span class="soc__rule" aria-hidden="true"></span>
  <div class="soc__text">
    <p class="soc__eyebrow">{SOCIAL.eyebrow}</p>
    <h3 class="soc__headline">{SOCIAL.headline}</h3>
    <p class="soc__body">{SOCIAL.body}</p>
    <div class="soc__actions">
      <a class="btn btn--primary" href={SOCIAL.cta.href}>{SOCIAL.cta.label}</a>
      <a class="link-arrow" href={SOCIAL.secondary.href}>
        {SOCIAL.secondary.label}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
  <svg class="soc__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2.4l2.7 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.1 6.1 20.3l1.2-6.4L2.6 9.1l6.4-.8z" />
  </svg>
</div>

<style>
  .soc {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-top: 2.25rem;
  }
  .soc__rule {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-gold-500) 0 64px,
      var(--color-border-light) 64px 100%
    );
  }
  .soc__text {
    max-width: 60ch;
  }
  .soc__mark {
    position: absolute;
    right: 0;
    bottom: -1rem;
    width: clamp(90px, 12vw, 150px);
    color: var(--color-navy-900);
    opacity: 0.06;
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .soc__mark {
      right: 4%;
      bottom: auto;
      top: 2rem;
    }
  }
  .soc__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
  }
  .soc__headline {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.125rem);
    line-height: 1.14;
    font-weight: 520;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .soc__body {
    margin-top: 0.9rem;
    color: var(--color-ink-500);
    font-size: 1rem;
    line-height: 1.65;
  }
  .soc__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
