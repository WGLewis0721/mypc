---
/**
 * MYPC identity lockup — layered civic star mark + wordmark (per the MYPC brandkit).
 * The mark is three offset 5-point stars (navy base, gold, civic-red accent) around a
 * central roundel with a capitol-dome hint. Used in header, footer, mobile nav.
 */
interface Props {
  sub?: boolean; // show the council + city sub-lines
  class?: string;
}
const { sub = false, class: cls } = Astro.props;
// A single 5-point star, points up, centred on 20,20.
const STAR =
  "M20 1 L24.7 13.8 L38.4 14.2 L27.6 22.7 L31.4 35.9 L20 28 L8.6 35.9 L12.4 22.7 L1.6 14.2 L15.3 13.8 Z";
---

<a href="/" class={`logo ${cls ?? ""}`} aria-label="MYPC — Mayor’s Young Professional Council, home">
  <svg class="logo__mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <path d={STAR} transform="translate(2 1.6) scale(1.04)" fill="var(--color-navy-700)" opacity="0.55" />
    <path d={STAR} transform="rotate(12 20 20)" fill="var(--color-red-600)" opacity="0.9" />
    <path d={STAR} fill="var(--color-gold-500)" />
    <circle cx="20" cy="20" r="6.4" fill="var(--color-navy-900)" />
    <path
      d="M14.6 25.2 V21 a5.4 3.4 0 0 1 10.8 0 V25.2 M20 15.1 v-2.2"
      fill="none"
      stroke="var(--color-gold-300)"
      stroke-width="1.3"
      stroke-linecap="round"
    />
  </svg>
  <span class="logo__text">
    <span class="logo__word">MYPC</span>
    {
      sub && (
        <>
          <span class="logo__sub">Mayor&rsquo;s Young Professional Council</span>
          <span class="logo__city">Montgomery, Alabama</span>
        </>
      )
    }
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo__mark {
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .logo__sub {
    margin-top: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cloud);
  }
  .logo__city {
    margin-top: 2px;
    font-size: 0.4375rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  @media (max-width: 1023px) {
    .logo__sub,
    .logo__city {
      display: none;
    }
  }
</style>
