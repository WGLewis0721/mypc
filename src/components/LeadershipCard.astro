---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  role: string;
  blurb?: string;
  featured?: boolean;
  img?: string;
}
const { name, role, blurb, featured = false, img } = Astro.props;
const alt = `${role}, Mayor’s Young Professional Council`;
---

{
  featured ? (
    <article class="lcf">
      <div class="lcf__photo">
        {img ? (
          <img src={img} alt={alt} width="520" height="650" loading="lazy" decoding="async" />
        ) : (
          <div class="ph" aria-hidden="true">
            <Icon name="star" size={22} />
            <span>Portrait to come</span>
          </div>
        )}
      </div>
      <div class="lcf__text">
        <p class="lcf__role">{role}</p>
        <p class="lcf__name">{name}</p>
        {blurb && <p class="lcf__blurb">{blurb}</p>}
      </div>
    </article>
  ) : (
    <article class="lc">
      <div class="lc__photo">
        {img ? (
          <img src={img} alt={alt} width="320" height="400" loading="lazy" decoding="async" />
        ) : (
          <div class="ph" aria-hidden="true">
            <Icon name="star" size={18} />
          </div>
        )}
        <div class="lc__scrim" />
        <div class="lc__meta">
          <p class="lc__role">{role}</p>
          <p class="lc__name">{name}</p>
        </div>
      </div>
    </article>
  )
}

<style>
  .ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(155deg, var(--color-navy-700), var(--color-navy-800) 72%);
    color: var(--color-gold-500);
  }
  .ph span {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-cloud);
  }

  /* compact card */
  .lc__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-on-navy);
    background: var(--color-navy-800);
  }
  .lc__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lc__scrim {
    position: absolute;
    inset: 38% 0 0 0;
    background: linear-gradient(
      to top,
      var(--color-navy-950) 6%,
      rgb(6 18 42 / 0.6) 45%,
      transparent 100%
    );
  }
  .lc__meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.85rem 0.9rem 0.95rem;
  }
  .lc__role {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-gold-300);
  }
  .lc__name {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.15;
    color: #fff;
  }

  /* featured card */
  .lcf {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .lcf__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-on-navy);
    background: var(--color-navy-800);
  }
  .lcf__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lcf__role {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold-500);
  }
  .lcf__name {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 500;
    line-height: 1.08;
    color: #fff;
  }
  .lcf__blurb {
    margin-top: 0.9rem;
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-cloud);
  }
  @media (min-width: 520px) {
    .lcf {
      grid-template-columns: minmax(200px, 240px) 1fr;
      align-items: center;
      gap: 1.75rem;
    }
  }
</style>
