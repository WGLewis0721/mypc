---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  action: { label: string; href: string };
  secondary?: { label: string; href: string };
  tone?: "gold" | "navy";
}
const { eyebrow, title, body, action, secondary, tone = "gold" } = Astro.props;
---

<div class:list={["cta", `cta--${tone}`]}>
  <svg class="cta__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2.4l2.7 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.1 6.1 20.3l1.2-6.4L2.6 9.1l6.4-.8z" />
  </svg>
  <div class="cta__text">
    {eyebrow && <p class="eyebrow cta__eyebrow">{eyebrow}</p>}
    <p class="cta__title">{title}</p>
    {body && <p class="cta__body">{body}</p>}
  </div>
  <div class="cta__actions">
    <a
      class:list={[
        "btn",
        "btn--lg",
        tone === "gold" ? "btn--secondary-light" : "btn--primary",
      ]}
      href={action.href}
    >
      {action.label}
      <Icon name="arrow-right" size={16} />
    </a>
    {
      secondary && (
        <a
          class:list={[
            "btn",
            tone === "gold" ? "btn--secondary-light" : "btn--secondary-navy",
          ]}
          href={secondary.href}
        >
          {secondary.label}
        </a>
      )
    }
  </div>
</div>

<style>
  .cta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: clamp(2rem, 1.4rem + 3vw, 3.25rem) clamp(1.5rem, 1rem + 3.5vw, 3.5rem);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .cta--gold {
    background:
      linear-gradient(135deg, var(--color-gold-400) 0%, var(--color-gold-500) 55%, #c69f2f 100%);
    color: var(--color-navy-950);
  }
  .cta--gold::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.28);
    pointer-events: none;
  }
  .cta--navy {
    background: var(--color-navy-800);
    color: #fff;
    border: 1px solid var(--border-on-navy);
  }
  .cta__mark {
    position: absolute;
    right: -3%;
    bottom: -34%;
    width: clamp(150px, 22vw, 260px);
    color: var(--color-navy-900);
    opacity: 0.12;
    pointer-events: none;
  }
  .cta--navy .cta__mark {
    color: var(--color-gold-500);
    opacity: 0.09;
  }
  .cta__text {
    position: relative;
    z-index: 1;
  }
  .cta__eyebrow {
    color: inherit;
    opacity: 0.7;
  }
  .cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.7vw, 2.25rem);
    line-height: 1.1;
    font-weight: 540;
    max-width: 20ch;
  }
  .cta__body {
    margin-top: 0.6rem;
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.88;
  }
  .cta__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    flex: none;
  }
  /* Solid navy action on the gold panel — high contrast, matches institutional square. */
  .cta--gold .cta__actions :global(.btn--secondary-light) {
    background: var(--color-navy-900);
    color: #fff;
    border-color: var(--color-navy-900);
  }
  .cta--gold .cta__actions :global(.btn--secondary-light:hover) {
    background: var(--color-navy-800);
    border-color: var(--color-navy-800);
  }
  @media (max-width: 560px) {
    .cta__actions {
      width: 100%;
    }
    .cta__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
